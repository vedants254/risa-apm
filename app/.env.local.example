# Copy to .env.local (never commit .env.local).
# LLM provider for the copilot: openai (default) or gemini
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional sampling. Unset = provider default. gpt-5.x on chat/completions needs no temperature and
# reasoning_effort=none for function tools; the adapter also learns both from the API's 400 and retries once.
# OPENAI_TEMPERATURE=
# OPENAI_REASONING_EFFORT=none

# Voice mode (OpenAI Realtime, speech to speech; uses OPENAI_API_KEY)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
# OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_REALTIME_REASONING_EFFORT=low

# Gemini via Google AI Studio (OpenAI-compatible endpoint)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Database: sqlite (default, data/growth.db) or postgres
DB_DRIVER=sqlite
# SQLITE_PATH=./data/growth.db
# DATABASE_URL=postgres://user:pass@host:5432/growth
# PG_POOL_MAX=3            # Postgres pool size (keep small on a transaction pooler)
# PG_SSL=require           # require (default for remote hosts) or disable

# Optional overrides
# DATASET_PATH=../dataset/Attendee_Dataset.xlsx
# PACE_CURVE_PATH=../analysis/derived/pace_curve.json
